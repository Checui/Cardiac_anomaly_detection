#!/bin/bash

# =============================================================================
# ROI CONTROLS — the two experiments that decide whether the motion-ROI result
# (M&Ms-Test 0.714 -> 0.782 flow_SSIM/mean, 0.743 -> 0.800 mag_SSIM/mid60) is a
# gain that belongs to the DETECTOR, or one that belongs to the MASK.
#
# The objection. `--roi motion` ranks the pooling mask on the GROUND-TRUTH flow
# magnitude and then scores the pred-vs-GT error inside it, so the mask conditions
# on the same field that appears in the error term. Three things sharpen it:
#   (a) the 2-D models are single-pass on ED, so a GT-ranked mask consumes the ES
#       frame the network never sees;
#   (b) |GT flow| is itself disease-correlated (a dilated, hypokinetic ventricle
#       moves less), so the mask carries diagnostic signal before the network is
#       consulted at all;
#   (c) SSIM's data_range and its local statistics are computed over the retained
#       region, so restricting to high-motion pixels also changes the score's
#       NORMALISATION as a function of the patient's motion amplitude.
# Suspicious corroborating pattern: the two ROIs that do NOT touch the GT field
# (central disc, heart segmentation) were null and null-to-negative.
#
#  CONTROL 1 — `--roi pred_motion`. The same top-30%-plus-dilation rule applied to
#      the model's OWN predicted magnitude channel. No GT conditioning, and no
#      second cardiac phase required, so it is deployable exactly where the model
#      is. If the gain survives here it is a property of the detector.
#
#  CONTROL 2 — the model-free streams gt_mag_{mean,std,cv}, now emitted by every
#      eval. They are statistics of the GT displacement field alone, pooled over
#      whatever ROI the arm uses, with the network removed entirely. They are the
#      floor the detector has to clear. Read |AUC - 0.5|: direction is not fixed
#      a priori, and a *low* AUC is just as informative as a high one.
#
# Rescoring only — no training. The flow head's prediction is fixed; only the
# support of the reduction changes. The `base` arm reproduces the established
# whole-frame numbers and is the regression gate.
#
# Output dirs are deliberately prefixed qfae_roictrl_* so nothing here overwrites
# the qfae_abcd_rescore_* artefacts that analyze_abcd.py gates on.
#
#   qsub -v ENC=mae224 qfae_roictrl.pbs
#   qsub -v ENC=dino224 qfae_roictrl.pbs
# =============================================================================

#PBS -N QFAE_ROIctrl
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -m ea
#PBS -M cc4525@imperial.ac.uk

cd $PBS_O_WORKDIR
ENC=${ENC:-mae224}
echo "Job started $(date)  ENC=${ENC}"; echo "Node: $(hostname)"
source ~/miniconda/bin/activate
source activate derisk
module load CUDA/11.8.0
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH
export HF_HOME=${HF_HOME:-$EPHEMERAL/hf_cache}
export HF_HUB_OFFLINE=1

python qfae_flowmetrics.py || { echo "FLOWMETRICS SMOKE FAILED — aborting"; exit 1; }

case "${ENC}" in
  mae224)  MODEL="vit_base_patch16_224.mae";        SRC="./qfae_dino2d_mae224_out"  ;;
  dino224) MODEL="vit_base_patch14_dinov2.lvd142m"; SRC="./qfae_dino2d_dino224_out" ;;
  *) echo "ERROR: set -v ENC=mae224|dino224"; exit 2 ;;
esac
[ -f "${SRC}/qfae.pt" ] || { echo "ERROR: no checkpoint at ${SRC}/qfae.pt"; exit 2; }

RC=0
CSV="../Dataset_1/211230_M&Ms_Dataset_information_diagnosis_opendataset.csv"
COMMON="--flow --dino_model ${MODEL} --img_size 224 --perceptual_backbone dino \
        --acdc_dir ../Dataset_2 --mm_dir ../Dataset_1/Training --mm_val_dir ../Dataset_1/Testing \
        --val_datasets ACDC MM --top_frac 0.2 --batch_size 32 --model_path ${SRC}/qfae.pt"

rescore () {   # $1 = arm name, $2.. = extra flags
  local arm="$1"; shift
  echo "=== roictrl ${ENC} / ${arm}: $* ==="
  python qfae_dino_eval.py ${COMMON} --mm_csv "${CSV}" "$@" \
      --out_dir "./qfae_roictrl_${ENC}_${arm}_mmtest" || RC=1
  echo "--- ${arm} done (rc=$RC) $(date) ---"
}

# base: regression gate (must reproduce flow_SSIM/mean 0.812/0.714 for mae224) and
#       the model-free streams measured over the whole frame.
rescore base
# motion: the published arm, re-run so its model-free streams exist for comparison.
rescore roi_motion      --roi motion      --motion_frac 0.3
# pred_motion: CONTROL 1.
rescore roi_pred_motion --roi pred_motion --motion_frac 0.3
# center: a purely geometric mask, the reference point for "how much is just cropping".
rescore roi_center      --roi center      --roi_frac 0.5

echo "--- ENC=${ENC} ROI controls finished (rc=$RC) $(date) ---"
echo "Next (offline): python analyze_roictrl.py"
exit $RC
