# ==========================================
# 1. Virtual Environments (Don't upload your whole Python setup)
# ==========================================
venv/
.venv/
env/
.env

# ==========================================
# 1b. Experiment outputs & large notebook backups
# ==========================================
derisk_out/
*.bak
*.bak2

# ==========================================
# 2. Datasets and Images (Don't upload massive data files)
# ==========================================
*.csv
*.dat
*.npy
*.npz
datasets/
data/
wandb/


# ==========================================
# 3. Machine Learning Models (Don't upload heavy trained weights)
# ==========================================
# PyTorch models
*.pth
*.pt
# TensorFlow/Keras models
*.h5
*.keras
generated/
training_saver/

# ==========================================
# 4. Python Compiled Files
# ==========================================
__pycache__/
*.pyc

# ==========================================
# 6. OS & Editor Files (Keeps it clean for other people)
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ==========================================
# 7. PBS job logs & old runs
# ==========================================
*.e[0-9]*
*.o[0-9]*
.old_runs/

# ==========================================
