#!/bin/bash

# -----------------------------------------------------------------------------
# PBS Job Configuration
# -----------------------------------------------------------------------------

# Give your job a descriptive name
#PBS -N Train_Registration_EDES

# Request the maximum time you think the job will take (HH:MM:SS)
# Maximum limit on Imperial HPC is usually 72:00:00. Here we request 24 hours.
#PBS -l walltime=24:00:00

# Request resources: 1 chunk (node), 4 CPU cores, 32GB RAM, and 1 GPU
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1

# Email Notification Settings
# 'b' = begin, 'e' = end, 'a' = abort (fail)
# Here we request emails on End or Abort.
#PBS -m ea

# IMPORTANT: Replace this with your actual Imperial College email address!
#PBS -M cc4525@imperial.ac.uk

# -----------------------------------------------------------------------------
# Job Execution Commands
# -----------------------------------------------------------------------------

# Navigate to the directory from which you submitted the qsub command
# (This ensures it looks for your python scripts and datasets in the right folder)
cd $PBS_O_WORKDIR

echo "Job started on $(date)"
echo "Running on node: $(hostname)"

# Load Imperial HPC modules
source ~/miniconda/bin/activate

# Load the CUDA module required for your TensorFlow version 
# (Commonly 11.2, 11.8, or 12.x depending on your TF version)
module load CUDA/11.8.0
conda install -c conda-forge cudatoolkit=11.8.0 cudnn -y

# Activate your Python virtual environment
# IMPORTANT: Replace 'mres_env' with the name of the conda environment you created on the HPC
source activate mres_env

# NOTE: for --aux_source registration, this env also needs PyTorch (CPU build is enough —
# the reg-net runs on CPU). Install it ONCE on the LOGIN node (compute nodes have no
# internet), then it persists for all jobs:
#   pip install torch --index-url https://download.pytorch.org/whl/cpu
# Not required for --aux_source flow (Farneback) or --model_type rgb.

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH
# Run your Python training script
# Note: Ensure the paths (--acdc_dir, --mm_dir, --mm_csv) perfectly match where 
# you placed them in your ephemeral storage relative to this script.
VERSION="registration_es_ed"

# IMPORTANT: --orient_normalize requires
#   ../reconstructed_sax_images_training_2023/segmentation/orientation_params.csv
# to exist on this filesystem (the CSV is not in the git repo; scp it from your
# local workstation, e.g.
#   scp orientation_params.csv user@hpc:/path/to/reconstructed_sax_images_training_2023/segmentation/
# ).  Without the CSV the flag silently no-ops per patient (pass-through).
#
# REGISTRATION aux target (--aux_source registration):
#   * --reg_repo points at the biomechanics repo (network.py + checkpoints/ckpt_best.pth).
#     On the HPC that folder is 'biomechanics-cardiac-motion-hpc' (NOT the local name), so
#     the sibling path below is required — the code's default would not resolve here.
#   * ed_es on ACDC+MM is the domain the reg-net was fine-tuned/validated on (Dice 0.762);
#     next_frame_systole / RECON are out-of-domain AND far slower (the reg-net runs once per
#     frame pair on CPU at data-load — thousands of pairs would take hours before training).
#   * needs PyTorch in the env (see note above). Checkpoints land in ..._FLOW_NOR_REG_${VERSION}.
# For an apples-to-apples Farneback baseline, rerun this block with --aux_source flow
# (drop --reg_repo) and a different --run_tag.

echo "--- Starting Model Training: Flow head, REGISTRATION aux target, ED/ES, ACDC+MM (version: ${VERSION}) ---"

python run_model.py \
    --model_type flow \
    --aux_source registration \
    --reg_repo ../biomechanics-cardiac-motion-hpc \
    --datasets ACDC MM \
    --frame_mode es_ed \
    --acdc_dir ../Dataset_2 \
    --mm_dir ../Dataset_1/Training \
    --mm_val_dir ../Dataset_1/Validation \
    --mm_csv "../Dataset_1/211230_M&Ms_Dataset_information_diagnosis_opendataset.csv" \
    --recon_dir ../reconstructed_sax_images_training_2023 \
    --orient_normalize \
    --spacing_normalize \
    --n4_bias_correct \
    --epochs 100 \
    --start_epoch 0 \
    --run_tag "${VERSION}"

echo "--- Training finished ---"
echo "Job finished on $(date)"
