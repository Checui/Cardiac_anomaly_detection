#!/bin/bash

# =============================================================================
# PHASE 2 — train a HYBRID QFAE with a MOTION (flow) head on a DINOv2 / MAE encoder,
# CineMA perceptual scorer (so only the ENCODER differs from the CineMA flow baseline
# qfae_flow_out). Answers: is DINOv2/MAE a better MOTION predictor than CineMA (flow_L1)?
# NOR-only, Farneback GT flow. Reduced epoch budget (motion converges fast).
#
#   qsub -v ENC=dino qfae_hybrid_flow_train.pbs   -> encoder=DINOv2 -> qfae_hybrid_dino_flow_out
#   qsub -v ENC=mae  qfae_hybrid_flow_train.pbs   -> encoder=MAE    -> qfae_hybrid_mae_flow_out
# Chain the eval with: qsub -W depend=afterok:<jobid> -v ENC=<enc> qfae_hybrid_flow_eval.pbs
# =============================================================================

#PBS -N QFAE_HybFlowTrain
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -m ea
#PBS -M cc4525@imperial.ac.uk

cd $PBS_O_WORKDIR
echo "Job started $(date)  ENC=${ENC}"; echo "Node: $(hostname)"

source ~/miniconda/bin/activate
source activate derisk
module load CUDA/11.8.0
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH
export HF_HOME=${HF_HOME:-$EPHEMERAL/hf_cache}
export HF_HUB_OFFLINE=1

case "${ENC}" in
  dino) DINO_MODEL="vit_base_patch14_dinov2.lvd142m"; IMG=224 ;;
  mae)  DINO_MODEL="vit_base_patch16_224.mae";        IMG=224 ;;
  *) echo "ERROR: set -v ENC=dino|mae"; exit 2 ;;
esac
OUT="./qfae_hybrid_${ENC}_flow_out"

# fail fast on any shape/grad bug before spending GPU-hours
python qfae_hybrid.py || { echo "SMOKE FAILED — aborting"; exit 1; }

echo "=== train encoder=${ENC} (${DINO_MODEL}) + flow head, scorer=cinema ==="
python qfae_hybrid_train.py \
    --encoder dino --dino_model "${DINO_MODEL}" --img_size ${IMG} \
    --scorer cinema --flow --lambda_flow 2.0 \
    --acdc_dir ../Dataset_2 --mm_dir ../Dataset_1/Training \
    --mm_csv "../Dataset_1/211230_M&Ms_Dataset_information_diagnosis_opendataset.csv" \
    --fit_datasets ACDC MM \
    --epochs 80 --batch_size 2 --lr 1e-4 --warmup_epochs 8 --perceptual_slices 6 \
    --out_dir "${OUT}"
RC=$?

echo "--- Finished (rc=$RC) $(date) ---  model: ${OUT}/qfae.pt"
exit $RC
