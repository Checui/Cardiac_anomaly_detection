#!/bin/bash

# =============================================================================
# Dual-stream QFAE — TRAINING with the REGISTRATION-net flow GT (vs Farneback).
# Same model/loss as qfae_flow.pbs, but the motion head's GT flow comes from the
# fine-tuned biomechanics Registration_Net teacher instead of Farneback. Writes
# ./qfae_flow_reg_out (Farneback run in ./qfae_flow_out is preserved). See the plan
# and cinema_faithful.set_flow_backend / registration_flow.py.
# =============================================================================

#PBS -N QFAE_FlowReg
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -m ea
#PBS -M cc4525@imperial.ac.uk

cd $PBS_O_WORKDIR
echo "Job started on $(date)"
echo "Running on node: $(hostname)"

source ~/miniconda/bin/activate
source activate derisk

module load CUDA/11.8.0
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

export HF_HOME=${HF_HOME:-$EPHEMERAL/hf_cache}
export HF_HUB_OFFLINE=1

echo "--- Training dual-stream QFAE (appearance + REGISTRATION flow) ---"

# --flow_backend registration: per-slice GT flow from the reg-net teacher (runs on CPU at
# data-load; needs torch + ../biomechanics-cardiac-motion-hpc/{network.py,checkpoints/ckpt_best.pth}).
python qfae_train.py \
    --acdc_dir ../Dataset_2 \
    --mm_dir ../Dataset_1/Training \
    --mm_csv "../Dataset_1/211230_M&Ms_Dataset_information_diagnosis_opendataset.csv" \
    --fit_datasets ACDC MM \
    --flow \
    --flow_backend registration \
    --reg_repo ../biomechanics-cardiac-motion-hpc \
    --lambda_flow 2.0 \
    --qformer_blocks 2 \
    --decoder_dim 512 \
    --decoder_depth 6 \
    --perceptual_layers 5 8 11 \
    --epochs 120 \
    --batch_size 2 \
    --lr 1e-4 \
    --warmup_epochs 10 \
    --out_dir ./qfae_flow_reg_out
RC=$?

echo "--- Finished (python rc=$RC) ---"
echo "Job finished on $(date)"
echo "Model: ./qfae_flow_reg_out/qfae.pt   (next: qsub qfae_flow_reg_eval.pbs)"
exit $RC
