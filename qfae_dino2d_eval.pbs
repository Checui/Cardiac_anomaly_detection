#!/bin/bash

# =============================================================================
# PHASE B eval — genuinely-2-D DINOv2/MAE motion QFAE on the HELD-OUT sets:
# ACDC-50 + M&Ms-TESTING. Per-slice appearance + 2-D flow scores; patient
# aggregation sweep runs offline via qfae_report.py --agg_sweep.
#   qsub -W depend=afterok:<train_jobid> -v CFG=dino224|dino518|mae224 qfae_dino2d_eval.pbs
# =============================================================================

#PBS -N QFAE_Dino2D_eval
#PBS -l walltime=01:30:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -m ea
#PBS -M cc4525@imperial.ac.uk

cd $PBS_O_WORKDIR
echo "Job started $(date)  CFG=${CFG}"; echo "Node: $(hostname)"
source ~/miniconda/bin/activate
source activate derisk
module load CUDA/11.8.0
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH
export HF_HOME=${HF_HOME:-$EPHEMERAL/hf_cache}
export HF_HUB_OFFLINE=1

case "${CFG}" in
  dino224)   MODEL="vit_base_patch14_dinov2.lvd142m";  SIZE=224; BS=32 ;;
  dino518)   MODEL="vit_base_patch14_dinov2.lvd142m";  SIZE=518; BS=8  ;;
  mae224)    MODEL="vit_base_patch16_224.mae";         SIZE=224; BS=32 ;;
  dinov3224) MODEL="vit_base_patch16_dinov3.lvd1689m"; SIZE=224; BS=32 ;;
  *) echo "ERROR: set -v CFG=dino224|dino518|mae224|dinov3224"; exit 2 ;;
esac
# RECOVER=1 pairs with the qfae_dino2d_${CFG}_ge_out model. The eval universe is IDENTICAL
# either way (M&Ms Testing has no ED==ES rows), which is what makes this a strict A/B.
SUFFIX=""
if [ "${RECOVER}" = "1" ]; then SUFFIX="_ge"; fi
OUT="./qfae_dino2d_${CFG}${SUFFIX}_out"

echo "=== eval 2-D ${CFG}${SUFFIX} on ACDC-50 + M&Ms-TESTING (held-out) ==="
python qfae_dino_eval.py \
    --flow --dino_model "${MODEL}" --img_size ${SIZE} --perceptual_backbone dino \
    --acdc_dir ../Dataset_2 --mm_dir ../Dataset_1/Training \
    --mm_val_dir ../Dataset_1/Testing \
    --mm_csv "../Dataset_1/211230_M&Ms_Dataset_information_diagnosis_opendataset.csv" \
    --val_datasets ACDC MM --top_frac 0.2 --batch_size ${BS} \
    --model_path "${OUT}/qfae.pt" --out_dir "${OUT}_mmtest"
RC=$?
echo "--- Finished (rc=$RC) $(date) ---  arrays: ${OUT}_mmtest/qfae_dino_arrays.npz"
echo "Next (offline): python qfae_report.py --agg_sweep ${OUT}_mmtest/qfae_dino_arrays.npz"
exit $RC
