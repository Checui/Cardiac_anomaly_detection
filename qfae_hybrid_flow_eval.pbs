#!/bin/bash

# =============================================================================
# PHASE 2 eval — score the hybrid flow-head QFAE directly on the HELD-OUT sets:
# ACDC-50 + M&Ms-TESTING (136, ~31 NOR). Emits appearance + flow_SSIM/mag_SSIM/
# flow_L1/combined into qfae_arrays.npz (same keys as qfae_flow_out), so qfae_report.py
# fuses it identically. Compare flow_L1 vs the CineMA baseline (0.713).
#   qsub -W depend=afterok:<train_jobid> -v ENC=dino|mae qfae_hybrid_flow_eval.pbs
# =============================================================================

#PBS -N QFAE_HybFlowEval
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -m ea
#PBS -M cc4525@imperial.ac.uk

cd $PBS_O_WORKDIR
echo "Job started $(date)  ENC=${ENC}"; echo "Node: $(hostname)"

source ~/miniconda/bin/activate
source activate derisk
module load CUDA/11.8.0
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH
export HF_HOME=${HF_HOME:-$EPHEMERAL/hf_cache}
export HF_HUB_OFFLINE=1

case "${ENC}" in
  dino) DINO_MODEL="vit_base_patch14_dinov2.lvd142m" ;;
  mae)  DINO_MODEL="vit_base_patch16_224.mae" ;;
  *) echo "ERROR: set -v ENC=dino|mae"; exit 2 ;;
esac
OUT="./qfae_hybrid_${ENC}_flow_out"

echo "=== eval encoder=${ENC} + flow head on ACDC-50 + M&Ms-TESTING (held-out) ==="
python qfae_hybrid_eval.py \
    --encoder dino --dino_model "${DINO_MODEL}" --img_size 224 \
    --scorer cinema --flow \
    --acdc_dir ../Dataset_2 --mm_dir ../Dataset_1/Training \
    --mm_val_dir ../Dataset_1/Testing \
    --mm_csv "../Dataset_1/211230_M&Ms_Dataset_information_diagnosis_opendataset.csv" \
    --val_datasets ACDC MM --perceptual_layers 5 8 11 --top_frac 0.2 --batch_size 2 \
    --model_path "${OUT}/qfae.pt" --out_dir "${OUT}_mmtest"
RC=$?

echo "--- Finished (rc=$RC) $(date) ---  results: ${OUT}_mmtest/qfae_results.json"
exit $RC
