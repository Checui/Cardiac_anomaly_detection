#!/bin/bash

# =============================================================================
# Dual-stream QFAE (REGISTRATION flow) — EVALUATION. Scores appearance + motion
# (Flow-SSIM etc.) using registration GT flow (MUST match training). Needs
# ./qfae_flow_reg_out/qfae.pt. Deliverable: registration flow_SSIM (ACDC/MM) vs
# the Farneback run (0.65 / 0.71).
# =============================================================================

#PBS -N QFAE_FlowReg_eval
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -m ea
#PBS -M cc4525@imperial.ac.uk

cd $PBS_O_WORKDIR
echo "Job started on $(date)"
echo "Running on node: $(hostname)"

source ~/miniconda/bin/activate
source activate derisk

module load CUDA/11.8.0
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

export HF_HOME=${HF_HOME:-$EPHEMERAL/hf_cache}
export HF_HUB_OFFLINE=1

echo "--- Evaluating dual-stream QFAE (registration flow GT) ---"

python qfae_eval.py \
    --flow \
    --flow_backend registration \
    --reg_repo ../biomechanics-cardiac-motion-hpc \
    --acdc_dir ../Dataset_2 \
    --mm_dir ../Dataset_1/Training \
    --mm_val_dir ../Dataset_1/Validation \
    --mm_csv "../Dataset_1/211230_M&Ms_Dataset_information_diagnosis_opendataset.csv" \
    --val_datasets ACDC MM \
    --model_path ./qfae_flow_reg_out/qfae.pt \
    --perceptual_layers 5 8 11 \
    --top_frac 0.2 \
    --batch_size 4 \
    --out_dir ./qfae_flow_reg_out

echo "--- Finished ---"
echo "Job finished on $(date)"
echo "Results: ./qfae_flow_reg_out/qfae_results.json"
