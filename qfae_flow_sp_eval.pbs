#!/bin/bash

# =============================================================================
# PHASE A eval — single-pass CineMA model on the HELD-OUT sets: ACDC-50 +
# M&Ms-TESTING (~31 NOR). Saves per-slice error maps (mask=none) so the offline
# reduction sweep (qfae_report.py --reduction_sweep) can pick the best rule.
#   qsub -W depend=afterok:<train_jobid> qfae_flow_sp_eval.pbs
# =============================================================================

#PBS -N QFAE_FlowSP_eval
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -m ea
#PBS -M cc4525@imperial.ac.uk

cd $PBS_O_WORKDIR
echo "Job started $(date)"; echo "Node: $(hostname)"
source ~/miniconda/bin/activate
source activate derisk
module load CUDA/11.8.0
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH
export HF_HOME=${HF_HOME:-$EPHEMERAL/hf_cache}
export HF_HUB_OFFLINE=1

python qfae_eval.py \
    --flow --single_pass \
    --acdc_dir ../Dataset_2 --mm_dir ../Dataset_1/Training \
    --mm_val_dir ../Dataset_1/Testing \
    --mm_csv "../Dataset_1/211230_M&Ms_Dataset_information_diagnosis_opendataset.csv" \
    --val_datasets ACDC MM --perceptual_layers 5 8 11 --top_frac 0.2 --batch_size 4 \
    --model_path ./qfae_flow_sp_out/qfae.pt --out_dir ./qfae_flow_sp_out_mmtest
RC=$?
echo "--- Finished (rc=$RC) $(date) ---  arrays: ./qfae_flow_sp_out_mmtest/qfae_arrays.npz"
echo "Next (offline): python qfae_report.py --reduction_sweep qfae_flow_sp_out_mmtest/qfae_arrays.npz"
exit $RC
